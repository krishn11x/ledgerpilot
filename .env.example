# ===========================================================================
# LedgerPilot -- environment template
#
#   cp .env.example .env      then fill in your own values
#
# This file is COMMITTED. Never put real keys, tokens or passwords here.
# All values below are placeholders or safe local-dev defaults.
# ===========================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
LP_ENV=development                  # development | staging | production
LP_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LP_LOG_FORMAT=console               # console | json

# ---------------------------------------------------------------------------
# Database
#
# Local dev (zero setup, default):
#   LP_DATABASE_URL=sqlite+pysqlite:///./data/ledgerpilot.db
#
# PostgreSQL (production shape -- schema and code are identical):
#   LP_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/ledgerpilot
# ---------------------------------------------------------------------------
LP_DATABASE_URL=sqlite+pysqlite:///./data/ledgerpilot.db
LP_DB_ECHO=false                    # true = log every SQL statement
LP_DB_POOL_SIZE=5

# ---------------------------------------------------------------------------
# Anthropic API  -- required only for the agent layer
#
# Get a key at https://console.anthropic.com/settings/keys
# Leave blank to run the deterministic engine with the agent disabled.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

LP_AGENT_ENABLED=false              # flip to true once a key is set
LP_AGENT_MODEL_TRIAGE=claude-sonnet-5      # high volume, cheap, fast
LP_AGENT_MODEL_ESCALATION=claude-opus-5    # hard tail cases only
LP_AGENT_MAX_STEPS=8                # tool-call budget per break
LP_AGENT_MAX_RETRIES=2              # retries when VERIFY rejects a proposal
LP_AGENT_TOKEN_BUDGET_PER_BREAK=20000

# ---------------------------------------------------------------------------
# Reconciliation policy
#
# Money is handled in INTEGER MINOR UNITS (paise). 50000 == INR 500.00
# ---------------------------------------------------------------------------
LP_BASE_CURRENCY=INR
LP_AMOUNT_TOLERANCE_MINOR=100       # 1.00 absolute wobble allowed
LP_AMOUNT_TOLERANCE_BPS=10          # 0.10% relative wobble allowed
LP_DATE_WINDOW_DAYS=3               # +/- days for candidate matching
LP_SETTLEMENT_LAG_DAYS=2            # gateway T+2 payout cycle
LP_FUZZY_MIN_SCORE=0.82             # accept a fuzzy match at/above this
LP_FUZZY_MIN_MARGIN=0.05            # top-2 must differ by this, else ambiguous

# ---------------------------------------------------------------------------
# Autonomy policy
#
# 0 = detect only            3 = auto-clear + auto-post journal entries
# 1 = propose, human approves all   4 = 3 + draft outbound comms
# 2 = auto-clear below materiality, escalate the rest
# ---------------------------------------------------------------------------
LP_AUTONOMY_LEVEL=2
LP_MATERIALITY_THRESHOLD_MINOR=50000   # 500.00 -- above this always escalates
LP_AUTO_APPROVE_MIN_CONFIDENCE=0.90

# ---------------------------------------------------------------------------
# Gateway fee schedule (synthetic Razorpay-shaped defaults)
# ---------------------------------------------------------------------------
LP_GATEWAY_FEE_BPS=200              # 2.00%
LP_GATEWAY_FEE_FLAT_MINOR=300       # + 3.00 per transaction
LP_GATEWAY_TAX_BPS=1800             # 18% GST on the fee

# ---------------------------------------------------------------------------
# Synthetic data generation
# ---------------------------------------------------------------------------
LP_SYNTH_SEED=42                    # fixed seed = reproducible ground truth
LP_SYNTH_ORDER_COUNT=8000
LP_SYNTH_PERIOD_DAYS=30

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
LP_API_HOST=127.0.0.1
LP_API_PORT=8000
LP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Frontend (Vite only exposes vars prefixed with VITE_)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
